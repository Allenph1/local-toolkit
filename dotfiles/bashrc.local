# local-toolkit bash additions

# shared command history across all sessions
shopt -s histappend
HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoredups:erasedups
PROMPT_COMMAND="history -a; history -c; history -r; $PROMPT_COMMAND"

export EDITOR="emacs -nw"
export VISUAL="$EDITOR"
export GIT_EDITOR="$EDITOR"
export GIT_SEQUENCE_EDITOR="$EDITOR"

alias ll='ls -lah --color=auto'
alias gs='git status -sb'
alias gco='git checkout'
alias gp='git pull --ff-only'

if [ -d "$HOME/local-toolkit/bin" ]; then
  export PATH="$HOME/local-toolkit/bin:$PATH"
fi

if shopt -q login_shell 2>/dev/null && [ -x "$HOME/local-toolkit/bin/mcp-autostart" ]; then
  "$HOME/local-toolkit/bin/mcp-autostart" >/dev/null 2>&1 &
fi
