{
  "name": "site-ops-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Generic site probing and UI test toolkit (Playwright)",
  "scripts": {
    "probe": "node src/probe.mjs",
    "probe-sg": "node src/probe-sg.mjs",
    "sg-auth": "node src/siteground-auth.mjs",
    "sg-live-capture": "node src/siteground-live-capture.mjs",
    "sg-api": "node src/siteground-api.mjs",
    "ui-capture": "playwright codegen",
    "sg-capture": "npm run sg-auth && playwright codegen --load-storage=.data/siteground-auth.json --save-storage=.data/siteground-auth.json https://my.siteground.com/paneladmin/sites",
    "sg-read": "node src/siteground-read.mjs",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
