#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=bin/lib/toolkit.sh
source "${ROOT_DIR}/bin/lib/toolkit.sh"

usage() {
  cat <<'EOF'
Usage: secret-run [--map FILE] [--env NAME=pass:secret/path]... -- command [args...]

Loads secret values from pass/GPG and injects them into the child command's
environment without printing the values.

Default map file:
  ~/.config/local-toolkit/secrets.map
EOF
  exit "${1:-2}"
}

default_map_file="${LOCAL_TOOLKIT_SECRET_MAP_FILE:-$HOME/.config/local-toolkit/secrets.map}"
map_files=()
inline_mappings=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --map)
      [[ $# -ge 2 ]] || usage
      map_files+=("$2")
      shift 2
      ;;
    --env)
      [[ $# -ge 2 ]] || usage
      inline_mappings+=("$2")
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -h|--help)
      usage 0
      ;;
    *)
      usage
      ;;
  esac
done

[[ $# -gt 0 ]] || usage

if [[ ${#map_files[@]} -eq 0 && -r "$default_map_file" ]]; then
  map_files+=("$default_map_file")
fi

declare -A resolved=()

resolve_pass_ref() {
  local env_name="$1"
  local ref="$2"

  tk_validate_env_name "$env_name"
  if [[ "$ref" != pass:* ]]; then
    echo "secret-run: $env_name must use pass:SECRET/NAME (got: $ref)" >&2
    exit 2
  fi

  local secret_name="${ref#pass:}"
  [[ -n "$secret_name" ]] || {
    echo "secret-run: $env_name needs a non-empty pass:SECRET/NAME mapping" >&2
    exit 2
  }
  local secret_value
  if ! secret_value="$(pass show -- "$secret_name")"; then
    echo "secret-run: missing or unreadable pass entry: $secret_name" >&2
    exit 1
  fi
  if [[ "$secret_value" == *$'\n'* || "$secret_value" == *$'\r'* ]]; then
    echo "secret-run: $secret_name contains a newline; secret-run only injects single-line values" >&2
    exit 1
  fi
  resolved["$env_name"]="$secret_value"
}

load_map_file() {
  local file="$1"
  [[ -r "$file" ]] || {
    echo "secret-run: missing or unreadable map file: $file" >&2
    exit 2
  }

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%$'\r'}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *"="* ]] || {
      echo "secret-run: invalid mapping line in $file: $line" >&2
      exit 2
    }

    local env_name="${line%%=*}"
    local ref="${line#*=}"
    [[ -n "$env_name" && -n "$ref" ]] || {
      echo "secret-run: invalid mapping line in $file: $line" >&2
      exit 2
    }

    resolve_pass_ref "$env_name" "$ref"
  done < "$file"
}

for file in "${map_files[@]}"; do
  load_map_file "$file"
done

for mapping in "${inline_mappings[@]}"; do
  [[ "$mapping" == *"="* ]] || {
    echo "secret-run: invalid --env mapping: $mapping" >&2
    exit 2
  }
  resolve_pass_ref "${mapping%%=*}" "${mapping#*=}"
done

if [[ ${#resolved[@]} -eq 0 ]]; then
  echo "secret-run: no secrets loaded. Add --map FILE or --env NAME=pass:secret/path." >&2
  exit 2
fi

env_args=()
for key in "${!resolved[@]}"; do
  export "$key=${resolved[$key]}"
done

exec "$@"
