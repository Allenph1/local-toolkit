#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="${ROOT_DIR}/mcp/docker-compose.yml"

if ! command -v docker >/dev/null 2>&1; then
  exit 0
fi

if ! docker compose version >/dev/null 2>&1; then
  echo "mcp-autostart: docker compose is unavailable" >&2
  exit 0
fi

if docker image inspect local-toolkit/site-ops-mcp:latest >/dev/null 2>&1; then
  docker compose -f "$COMPOSE_FILE" up -d --remove-orphans >/dev/null
else
  docker compose -f "$COMPOSE_FILE" up -d --build --remove-orphans >/dev/null
fi
