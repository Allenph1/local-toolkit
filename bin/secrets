#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SECRET_RUN="${ROOT_DIR}/bin/secret-run"
MAP_FILE="${LOCAL_TOOLKIT_SECRET_MAP_FILE:-$HOME/.config/local-toolkit/secrets.map}"
# shellcheck source=bin/lib/toolkit.sh
source "${ROOT_DIR}/bin/lib/toolkit.sh"

usage() {
  cat <<'EOF'
Usage:
  secrets doctor
  secrets gpg
  secrets init [GPG_ID]
  secrets add [ENV_NAME] [PASS_PATH]
  secrets map [ENV_NAME] [PASS_PATH]
  secrets list
  secrets edit
  secrets run -- command [args...]

Examples:
  secrets gpg
  secrets add APP_TOKEN app/token
  secrets add DB_PASSWORD db/password
  secrets run -- env | grep APP_TOKEN
EOF
}

die() {
  tk_error "secrets: $*"
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

ensure_map_file() {
  mkdir -p "$(dirname "$MAP_FILE")"
  touch "$MAP_FILE"
  chmod 600 "$MAP_FILE"
}

ensure_tty() {
  [[ -t 0 ]] || die "$1 requires an interactive terminal"
}

pass_initialized() {
  pass ls >/dev/null 2>&1
}

gpg_secret_keys() {
  gpg --list-secret-keys --keyid-format LONG --with-colons 2>/dev/null | awk -F: '
    $1 == "sec" {
      split($5, parts, "/")
      if (key != "" && uid != "") {
        print key "\t" uid
      }
      key = parts[length(parts)]
      uid = ""
    }
    $1 == "uid" && uid == "" {
      uid = $10
    }
    END {
      if (key != "" && uid != "") {
        print key "\t" uid
      }
    }
  '
}

select_gpg_id() {
  need_cmd gpg
  ensure_tty "secrets init"

  local choices=()
  mapfile -t choices < <(gpg_secret_keys)

  ((${#choices[@]} > 0)) || die "no secret GPG keys found. Run: secrets gpg"

  if command -v fzf >/dev/null 2>&1; then
    local picked
    picked="$(printf '%s\n' "${choices[@]}" | fzf --delimiter=$'\t' --with-nth=1,2 --prompt='Select GPG key> ')" || exit 1
    printf '%s' "${picked%%$'\t'*}"
    return
  fi

  local i=1
  for choice in "${choices[@]}"; do
    printf '%s) %s\n' "$i" "${choice//$'\t'/  }"
    i=$((i + 1))
  done
  printf 'Select GPG key number: ' >&2
  local selection
  read -r selection
  [[ "$selection" =~ ^[0-9]+$ ]] || die "invalid selection"
  (( selection >= 1 && selection <= ${#choices[@]} )) || die "selection out of range"
  printf '%s' "${choices[$((selection - 1))]%%$'\t'*}"
}

default_gpg_uid() {
  local user="${USER:-local-toolkit}"
  local host
  host="$(hostname -s 2>/dev/null || echo localhost)"
  printf '%s on %s <%s@%s>' "$user" "$host" "$user" "$host"
}

create_gpg_key() {
  local uid="$1"
  gpg --batch --yes --pinentry-mode loopback --passphrase '' \
    --quick-generate-key "$uid" rsa4096 sign,encrypt never
}

preferred_gpg_id() {
  local keys=()
  mapfile -t keys < <(gpg_secret_keys)
  if ((${#keys[@]} == 0)); then
    return 1
  fi
  printf '%s' "${keys[0]%%$'\t'*}"
}

cmd_gpg() {
  need_cmd gpg
  tk_note "gpg setup"
  local keys=()
  mapfile -t keys < <(gpg_secret_keys)
  if ((${#keys[@]} == 0)); then
    local uid
    uid="$(default_gpg_uid)"
    printf '  no secret keys found; creating %s\n' "$uid"
    create_gpg_key "$uid"
    mapfile -t keys < <(gpg_secret_keys)
  fi

  ((${#keys[@]} > 0)) || die "no secret GPG keys found after key creation"

  local gpg_id
  gpg_id="${keys[0]%%$'\t'*}"

  printf '  initializing pass with %s\n' "$gpg_id"
  pass init "$gpg_id"
  printf '  done\n'
}

write_map_line() {
  local env_name="$1"
  local ref="$2"
  ensure_map_file
  tk_require_cmd flock

  local dir tmp lock_fd=9
  dir="$(dirname "$MAP_FILE")"
  exec {lock_fd}>"${MAP_FILE}.lock"
  flock "$lock_fd"
  tmp="$(mktemp -p "$dir" ".${MAP_FILE##*/}.XXXXXX")"
  trap 'rm -f "$tmp"' RETURN
  awk -v key="$env_name" -v value="$ref" -F= '
    $1 == key {
      print key "=" value
      seen = 1
      next
    }
    { print }
    END {
      if (!seen) {
        print key "=" value
      }
    }
  ' "$MAP_FILE" > "$tmp"
  mv -f "$tmp" "$MAP_FILE"
  rm -f "$tmp"
  trap - RETURN
  exec {lock_fd}>&-
}

cmd_doctor() {
  local local_env local_ref
  tk_note "secret store"
  local gpg_ready=false
  if command -v gpg >/dev/null 2>&1; then
    local gpg_keys=()
    mapfile -t gpg_keys < <(gpg_secret_keys)
    if ((${#gpg_keys[@]} > 0)); then
      gpg_ready=true
    fi
  fi
  if [[ "$gpg_ready" == true ]]; then
    printf '  gpg:   ready\n'
  else
    printf '  gpg:   not ready\n'
    printf '  fix:   secrets gpg\n'
  fi

  if pass_initialized; then
    printf '  pass: initialized\n'
  else
    printf '  pass: not initialized\n'
    printf '  fix:  secrets init\n'
  fi

  printf '  map:  %s\n' "$MAP_FILE"
  if [[ -r "$MAP_FILE" ]]; then
    printf '  map entries:\n'
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%%$'\r'}"
      [[ -z "$line" || "$line" == \#* ]] && continue
      [[ "$line" == *"="* ]] || continue
      local_env="${line%%=*}"
      local_ref="${line#*=}"
      if pass_initialized && pass show -- "${local_ref#pass:}" >/dev/null 2>&1; then
        printf '    %-24s %s [ok]\n' "$local_env" "$local_ref"
      else
        printf '    %-24s %s [missing]\n' "$local_env" "$local_ref"
      fi
    done < "$MAP_FILE"
  else
    printf '  map:  missing\n'
    printf '  fix:  secrets add APP_TOKEN app/token\n'
  fi
}

cmd_init() {
  local gpg_id="${1:-}"
  if [[ -z "$gpg_id" ]]; then
    if ! gpg_id="$(preferred_gpg_id)"; then
      cmd_gpg
      return
    fi
  fi
  pass init "$gpg_id"
}

cmd_map() {
  local env_name="${1:-}"
  local pass_path="${2:-}"

  [[ -n "$env_name" && -n "$pass_path" ]] || die "usage: secrets map ENV_NAME PASS_PATH"
  tk_validate_env_name "$env_name"
  tk_validate_pass_path "$pass_path"
  write_map_line "$env_name" "pass:$pass_path"
  echo "mapped $env_name -> pass:$pass_path"
}

cmd_add() {
  local env_name="${1:-}"
  local pass_path="${2:-}"

  if [[ -z "$env_name" ]]; then
    ensure_tty "secrets add"
    printf 'Secret name (used for env var and pass path): ' >&2
    read -r env_name
  fi
  if [[ -z "$pass_path" ]]; then
    pass_path="$env_name"
  fi

  tk_validate_env_name "$env_name"
  tk_validate_pass_path "$pass_path"
  pass_initialized || die "pass store is not initialized. Run: secrets init"
  pass insert -- "$pass_path"
  write_map_line "$env_name" "pass:$pass_path"
}

cmd_list() {
  local local_env local_ref local_path status
  ensure_map_file
  if [[ ! -s "$MAP_FILE" ]]; then
    tk_warn "secrets: map file is empty: $MAP_FILE"
    exit 1
  fi

  printf '%-24s %-36s %s\n' "ENV" "PASS PATH" "STATUS"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%$'\r'}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *"="* ]] || continue
    local_env="${line%%=*}"
    local_ref="${line#*=}"
    local_path="${local_ref#pass:}"
    status="missing"
    if pass_initialized && pass show -- "$local_path" >/dev/null 2>&1; then
      status="ok"
    elif ! pass_initialized; then
      status="uninitialized"
    fi
    printf '%-24s %-36s %s\n' "$local_env" "$local_path" "$status"
  done < "$MAP_FILE"
}

cmd_edit() {
  ensure_map_file
  "${VISUAL:-${EDITOR:-vi}}" "$MAP_FILE"
}

cmd_run() {
  [[ $# -gt 0 ]] || die "usage: secrets run -- command [args...]"
  exec "$SECRET_RUN" -- "$@"
}

main() {
  local cmd="${1:-help}"
  if [[ $# -gt 0 ]]; then
    shift
  fi

  case "$cmd" in
    doctor|status)
      cmd_doctor
      ;;
    gpg)
      cmd_gpg
      ;;
    init)
      cmd_init "${1:-}"
      ;;
    add)
      cmd_add "${1:-}" "${2:-}"
      ;;
    map)
      cmd_map "${1:-}" "${2:-}"
      ;;
    list)
      cmd_list
      ;;
    edit)
      cmd_edit
      ;;
    run)
      [[ "${1:-}" == "--" ]] && shift
      cmd_run "$@"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
